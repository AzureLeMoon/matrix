services:
  aether:
    container_name: aether
    deploy:
      resources:
        limits:
          memory: 300M
    network_mode: host
    environment:
      - AETHER_SOCKS=127.0.0.1:1819
      - AETHER_IP=IPv4
      - AETHER_SCAN=turbo
      - AETHER_MASQUE_HTTP2=true
      #- AETHER_NOIZE=gfw
      - AETHER_QUICK_RECONNECT=1
    restart: always
    image: ghcr.io/cluvexstudio/aether:latest