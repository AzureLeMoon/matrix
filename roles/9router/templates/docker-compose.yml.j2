services:
  9router:
    image: decolua/9router:latest
    container_name: 9router
    restart: always
    ports:
      - "10.83.0.221:20128:20128"
    volumes:
      - ./data:/app/data
    env_file: .env  
    depends_on:
      - headroom
    networks:
      - router9_net
      
  headroom:
    image: ghcr.io/chopratejas/headroom:latest
    container_name: headroom
    restart: always
    ports:
      - "127.0.0.1:8787:8787"
    networks:
      - router9_net

  searxng:
    container_name: searxng
    image: docker.io/searxng/searxng:latest
    restart: always
    ports:
      - "10.83.0.221:8080:8080"
    env_file: .env.searxng
    volumes:
      - ./searxng-config/:/etc/searxng/:Z
      - ./searxng-data:/var/cache/searxng/
    networks:
      - router9_net

  valkey:
    container_name: valkey
    image: docker.io/valkey/valkey:9-alpine
    command: valkey-server --save 30 1 --loglevel warning
    restart: always
    volumes:
      - ./valkey-data:/data/      
    networks:
      - router9_net

networks:
  router9_net:
    driver: bridge
